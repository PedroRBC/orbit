# Copie para .env. Nunca compartilhe a chave ou o arquivo .env.
# O app inicia sem IA: nenhum endpoint é chamado enquanto faltar configuração.
AI_PROTOCOL=openai
# URL inclui o prefixo exigido pelo serviço (ex.: https://seu-servidor.example/v1).
# Anthropic geralmente usa a raiz (ex.: https://api.anthropic.com).
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Modelo explícito para briefing; vazio desabilita apenas o briefing.
AI_BRIEFING_MODEL=
# Preços próprios desse modelo. Necessários se AI_DAILY_USD_LIMIT estiver ativo.
AI_BRIEFING_INPUT_USD_PER_MILLION=
AI_BRIEFING_OUTPUT_USD_PER_MILLION=

# Teto diário conservador: entrada estimada + saída máxima, inclusive retentativas.
AI_DAILY_TOKEN_LIMIT=50000
AI_MAX_OUTPUT_TOKENS=3000
# Opcional: preços em USD por milhão de tokens, informados pelo seu fornecedor.
# Sem preços, custo aparece como desconhecido; o teto em tokens continua ativo.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
AI_DAILY_USD_LIMIT=

# Limite de metadados por fonte e execução, entre 1 e 50.
COLLECTOR_MAX_ITEMS=20
# Agenda padrão três vezes ao dia. Fuso vazio usa o do sistema.
SCHEDULER_ENABLED=true
COLLECTOR_CRON=0 8,14,20 * * *
COLLECTOR_TIMEZONE=
# Proteção contra cron excessivo: limite automático em 24h (1–12).
COLLECTOR_MAX_RUNS_PER_DAY=6

ORBIT_DB_PATH=data/orbit.db
# Destino de `npm run db:backup` (cópia online verificada do SQLite).
ORBIT_BACKUP_DIR=data/backups
PORT=3000
# A ponte da extensão escuta apenas em 127.0.0.1. Vazio usa PORT + 1.
ORBIT_EXTENSION_PORT=
# Acesso LAN: altere explicitamente para 0.0.0.0. Sem autenticação: use rede confiável.
ORBIT_HOST=127.0.0.1
NEXT_TELEMETRY_DISABLED=1
